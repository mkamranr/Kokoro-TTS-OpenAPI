# CPU-only build: slim Python base + CPU wheels of PyTorch (no CUDA libs).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/hf \
    KOKORO_DEVICE=cpu \
    KOKORO_HOST=0.0.0.0 \
    KOKORO_PORT=8080

# espeak-ng as belt and braces alongside the espeakng-loader wheel; curl for HEALTHCHECK.
RUN apt-get update \
    && apt-get install -y --no-install-recommends espeak-ng curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install CPU-only torch FIRST so later deps don't pull the CUDA build.
# If requirements-gpu.txt lists torchaudio/torchvision, add them here with matching versions
# (e.g. torchaudio==2.5.1), since the filter below strips all torch* lines.
RUN pip install --no-cache-dir torch==2.5.1 --index-url https://download.pytorch.org/whl/cpu

COPY requirements-base.txt requirements-gpu.txt ./

# Reuse the GPU requirements minus torch/CUDA index lines, and pin torch so nothing
# upgrades it to a CUDA build.
RUN grep -viE '^\s*(torch|--index-url|--extra-index-url|-i\s)' requirements-gpu.txt > requirements-cpu.txt \
    && echo "torch==2.5.1" > /tmp/constraints.txt \
    && pip install --no-cache-dir -r requirements-cpu.txt -c /tmp/constraints.txt

# misaki's English G2P needs the spaCy tagger. Installed as a wheel (more reliable than
# `spacy download`). Version must match spaCy's minor version: 3.8.0 for spaCy 3.8.x,
# 3.7.1 for spaCy 3.7.x.
RUN pip install --no-cache-dir \
    https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl

COPY app ./app
COPY web ./web
COPY scripts ./scripts

# Bake the weights and all 28 English voices so the container starts offline.
RUN python scripts/bake_assets.py

RUN useradd --create-home --uid 10001 kokoro \
    && mkdir -p /opt/hf \
    && chown -R kokoro:kokoro /opt/hf /app
USER kokoro

EXPOSE 8080
# CPU model load + warm-up is slower, so give it a longer start period.
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/health || exit 1

# Uses the launcher so KOKORO_HOST / KOKORO_PORT above are honored.
CMD ["python", "-m", "app"]
